    <string name="help_about_title">Fisalia Files v%1$s</string>
    <string name="help_about_description">Fisalia Files is a modern file manager with a Material You-inspired design, a built-in media player (ExoPlayer), and support for SMB, FTP, SFTP, and WebDAV network storage.</string>
    <string name="help_feedback_button">Send feedback via email</string>
